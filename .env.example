# Neon PostgreSQL — development branch
# Pooled connection (hostname contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Unpooled/direct connection, used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"
# NextAuth: a random secret (`npx auth secret`) and the GitHub OAuth app's
# client id and secret (callback: <AUTH_URL>/api/auth/callback/github).
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Resend API key for verification and password-reset emails.
RESEND_EMAIL_API_KEY=
# Sender for verification emails. Defaults to "DevStash <onboarding@resend.dev>",
# which only delivers to the Resend account owner until a domain is verified.
EMAIL_FROM=
# Absolute app origin used in email links. Defaults to http://localhost:3000.
AUTH_URL=
# Set to "false" to switch email verification off (any other value, or unset,
# keeps it on). Useful until a Resend domain is verified.
EMAIL_VERIFICATION_ENABLED=
# Upstash Redis for auth rate limiting. When unset, limiting is skipped.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cloudflare R2 for file and image uploads (S3-compatible API). The bucket stays
# private: files are served through /api/items/[id]/file, never from R2 directly.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Stripe billing for DevStash Pro (test-mode keys locally, live keys only in
# production). No publishable key: Checkout and the Customer Portal are
# full-page redirects, with no Stripe.js on the client.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the Dashboard endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=
# Recurring prices of the "DevStash Pro" product: $8/month and $72/year.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
# Set to "true" to enforce Free-tier limits and Pro-only features. Any other
# value (or unset) gives every account full access, as during development.
PRO_GATING_ENABLED=

# Neon PostgreSQL — development branch
# Pooled connection (hostname contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Unpooled/direct connection, used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Sender for verification emails. Defaults to "DevStash <onboarding@resend.dev>",
# which only delivers to the Resend account owner until a domain is verified.
EMAIL_FROM=
# Absolute app origin used in email links. Defaults to http://localhost:3000.
AUTH_URL=

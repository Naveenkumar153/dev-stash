// DevStash — Prisma schema
// Prisma 7: the `prisma-client` generator requires an explicit `output`, and the
// datasource URL lives in `prisma.config.ts` (not in this file).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// --- Content kind for an item's payload ---
enum ContentType {
  text
  url
  file
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // Credentials auth (email / password). Null for OAuth-only accounts.
  passwordHash String?

  // Billing / entitlement
  isPro                Boolean @default(false)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // Monaco editor settings (font size, tab size, word wrap, minimap, theme).
  // Null means every default; the app parses it and falls back per key.
  editorPreferences Json?

  // Relations
  items       Item[]
  collections Collection[]
  itemTypes   ItemType[] // custom (user-owned) types only
  folders     Folder[]

  accounts Account[] // NextAuth
  sessions Session[] // NextAuth

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model ItemType {
  id       String  @id @default(cuid())
  name     String
  icon     String
  color    String
  isSystem Boolean @default(false)

  // null for system types; set for user-created custom types
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items                 Item[]
  defaultForCollections Collection[] @relation("CollectionDefaultType")

  @@unique([userId, name])
  @@index([userId])
  @@map("item_types")
}

model Item {
  id          String      @id @default(cuid())
  title       String
  contentType ContentType @default(text)

  // Text payload (null when file-based)
  content String?

  // File payload (null when text-based)
  fileUrl  String? // Cloudflare R2 object key, served through /api/items/[id]/file
  fileName String?
  fileSize Int? // bytes

  // Link payload
  url String?

  description String?
  isFavorite  Boolean @default(false)
  isPinned    Boolean @default(false)
  language    String? // optional syntax-highlight hint for code

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemTypeId String
  itemType   ItemType @relation(fields: [itemTypeId], references: [id])

  tags        Tag[]
  collections ItemCollection[]

  // The folder a file item sits in on /items/files; null at the top level.
  // SetNull, never Cascade: deleting a folder's files has to go through the
  // app so their R2 objects are removed too, and a database cascade would
  // leave those objects in the bucket with no row pointing at them.
  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Both list queries filter on userId and order newest first, so the sort has
  // to be part of the index or Postgres sorts every one of the user's rows to
  // return ten. Leading userId also serves the plain where: { userId } counts.
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, isPinned, createdAt(sort: Desc), id(sort: Desc)])
  // The per-type list pages (/items/[type]) filter on the owner and the type,
  // newest first, and the sidebar's per-type counts group a user's rows by type.
  @@index([userId, itemTypeId, createdAt(sort: Desc), id(sort: Desc)])
  // Still needed on its own for the foreign key, which isn't led by userId.
  @@index([itemTypeId])
  @@index([folderId])
  @@map("items")
}

// A folder on /items/files. Folders nest to any depth through parentId.
// Sibling names are unique per user ignoring case, which the schema can't
// express (and NULL parentIds would defeat a plain @@unique at the top
// level), so the folder actions check it.
model Folder {
  id   String @id @default(cuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Null at the top level. Folders hold no R2 objects themselves, so a
  // cascade here only reaches sub-folders, and their items fall back to the
  // top level through Item.folder's SetNull rather than being deleted.
  parentId String?
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")

  items Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, parentId])
  @@index([parentId])
  @@map("folders")
}

model Collection {
  id          String  @id @default(cuid())
  name        String
  description String?
  isFavorite  Boolean @default(false)

  // Default type for a brand-new, empty collection
  defaultTypeId String?
  defaultType   ItemType? @relation("CollectionDefaultType", fields: [defaultTypeId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items ItemCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Recent collections, and the sidebar's favorites / non-favorites split.
  // Carries the id tie-break so the stable ordering stays an index scan.
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, isFavorite, createdAt(sort: Desc), id(sort: Desc)])
  @@index([defaultTypeId])
  @@map("collections")
}

// Join table: Item <-> Collection (many-to-many, with metadata)
model ItemCollection {
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@id([itemId, collectionId])
  @@index([collectionId])
  @@map("item_collections")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  items Item[]

  @@map("tags")
}

// --- NextAuth v5 ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
